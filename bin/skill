#!/usr/bin/env bash
# skill — activate, deactivate and search the installed skill catalogue.
#
#   .commandcode/skills/  archive: every skill ever installed
#   .claude/skills/       active:  the subset Claude Code loads
#
# Activating copies a skill from the archive into the active set.

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
archive="$root/.commandcode/skills"
active="$root/.claude/skills"

die() { printf 'skill: %s\n' "$1" >&2; exit 1; }

[ -d "$archive" ] || die "no archive at $archive"
mkdir -p "$active"

# Print a skill's description, trimmed to one line of at most $2 chars.
describe() {
  local f="$1/SKILL.md" max="${2:-72}"
  [ -f "$f" ] || return 0
  sed -n 's/^description:[[:space:]]*//p' "$f" | head -1 |
    sed "s/^['\"]//; s/['\"]$//" | cut -c "1-$max"
}

is_active() { [ -d "$active/$1" ]; }

list_archive() { ls "$archive"; }

# Active skills, excluding bookkeeping files like README.md.
list_active() {
  find "$active" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

cmd_find() {
  [ $# -gt 0 ] || die "usage: skill find <query>"
  local q="$*" hits=0
  while read -r name; do
    local d; d=$(describe "$archive/$name" 200)
    if printf '%s\n%s' "$name" "$d" | grep -qi -- "$q"; then
      hits=$((hits + 1))
      local mark="  "; is_active "$name" && mark="* "
      printf '%s%-34s %s\n' "$mark" "$name" "$(describe "$archive/$name" 74)"
    fi
  done < <(list_archive)
  if [ "$hits" -eq 0 ]; then
    printf 'no skill matches "%s"\n' "$q"
  else
    printf '\n%d match(es); * = already active\n' "$hits"
  fi
}

cmd_on() {
  [ $# -gt 0 ] || die "usage: skill on <name>..."
  for name in "$@"; do
    if [ ! -d "$archive/$name" ]; then
      printf '  ?  %-30s not in archive — try: skill find %s\n' "$name" "$name"
      continue
    fi
    if is_active "$name"; then
      printf '  =  %-30s already active\n' "$name"
      continue
    fi
    cp -r "$archive/$name" "$active/$name"
    printf '  +  %-30s %s\n' "$name" "$(describe "$archive/$name" 60)"
  done
}

cmd_off() {
  [ $# -gt 0 ] || die "usage: skill off <name>..."
  for name in "$@"; do
    # Never delete outside the active directory.
    case "$name" in */*|.|..|'') printf '  !  %-30s invalid name\n' "$name"; continue;; esac
    if ! is_active "$name"; then
      printf '  =  %-30s not active\n' "$name"
      continue
    fi
    [ -d "$archive/$name" ] || printf '  !  %-30s NOT in archive — removing loses it (git history still has it)\n' "$name"
    rm -rf "${active:?}/$name"
    printf '  -  %-30s deactivated\n' "$name"
  done
}

cmd_ls() {
  local n=0
  while read -r name; do
    [ -n "$name" ] || continue
    n=$((n + 1))
    printf '  %-34s %s\n' "$name" "$(describe "$active/$name" 74)"
  done < <(list_active)
  printf '\n%d active of %d in archive\n' "$n" "$(list_archive | wc -l)"
}

cmd_info() {
  [ $# -eq 1 ] || die "usage: skill info <name>"
  local name="$1" dir
  if is_active "$name"; then dir="$active/$name"
  elif [ -d "$archive/$name" ]; then dir="$archive/$name"
  else die "unknown skill: $name"; fi

  printf '%s  [%s]\n\n' "$name" "$(is_active "$name" && echo active || echo archived)"
  sed -n '/^---$/,/^---$/p' "$dir/SKILL.md" | sed '1d;$d'
  printf '\nfiles:\n'
  find "$dir" -type f -printf '  %P\n' | sort

  # Surface anything the skill needs before it will run.
  local needs
  needs=$(grep -rhoE '\b[A-Z][A-Z0-9_]{4,}(_API_KEY|_KEY|_TOKEN)\b' "$dir" 2>/dev/null | sort -u || true)
  [ -n "$needs" ] && printf '\nenvironment:\n%s\n' "$(echo "$needs" | sed 's/^/  /')"
  return 0
}

case "${1:-}" in
  find|search) shift; cmd_find "$@" ;;
  on|add|enable) shift; cmd_on "$@" ;;
  off|rm|disable) shift; cmd_off "$@" ;;
  ls|list) shift; cmd_ls "$@" ;;
  info|show) shift; cmd_info "$@" ;;
  ''|-h|--help|help)
    cat <<'USAGE'
skill — manage which of the installed skills Claude Code loads

  skill ls                 list active skills
  skill find <query>       search the archive by name and description
  skill info <name>        show a skill's frontmatter, files and required env
  skill on <name>...       activate (copy archive -> .claude/skills/)
  skill off <name>...      deactivate (remove from .claude/skills/)

Skills stay in .commandcode/skills/ either way, so nothing is lost by
deactivating. Keep the active set small — Claude Code weighs every active
description when choosing a skill.
USAGE
    ;;
  *) die "unknown command: $1 (try: skill help)" ;;
esac
